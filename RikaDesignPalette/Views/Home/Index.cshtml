@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://kit.fontawesome.com/a576612222.css" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/theme.css">
    <link rel="stylesheet" href="~/css/design-palette.css">
    <title>Rika - Design Palette</title>
</head>
<body>
    <div class="design-palette">
        <div class="container">
            <h1>H1 Title</h1>
            <h2>H2 Title</h2>
            <h3>H3 Title</h3>
            <h4>H4 Title</h4>
            <h5>H5 Title</h5>
            <h6>H6 Title</h6>
            <p>Paragraph</p>
            <a href="#">This is a link</a>
            <button class="button btn-primary">Primary Button</button>
            <button class="button btn-secondary">Secondary Button</button>
            <button class="button btn-third">Third Button</button>
            <div class="input-field">
                <input type="email" id="email" name="email" placeholder="Enter your email">
                <span class="error-message">Please enter a valid email address.</span>
            </div>
        </div>
    </div>
</body>
</html>
